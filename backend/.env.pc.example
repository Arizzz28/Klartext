# Copy to ".env.pc" (same folder). NEVER share or commit it: it contains the keys to your database.
# These values must be THE SAME as on Render (copy them from Render -> Environment):
DATABASE_URL=
SECRET_KEY=
OWNER_USERNAME=
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ALLOWED_ORIGINS=https://arizzz28.github.io
# New (also add PC_SECRET on Render!). A long random text, e.g.  python -c "import secrets; print(secrets.token_hex(24))"
PC_SECRET=
# Address of your normal server:
MAIN_SERVER_URL=https://chatisfying-backend.onrender.com
PC_PORT=5055
# Optional: if you run your own tunnel, write its https address here. Otherwise cloudflared.exe starts one automatically.
PC_PUBLIC_URL=
