# Copy this file to ".env" and fill in your values. NEVER commit ".env".

# Random secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# (If empty, a key is generated and stored in data/.secret_key)
SECRET_KEY=

# The OWNER is the top instance: always has every permission, can create/edit/delete ranks, cannot be demoted or deleted.
# Set this to your own username (for example Aris). If empty, ADMIN_USERNAME is used (so old setups keep working).
OWNER_USERNAME=Aris
# Old name from Version 1/2. Still works as a fallback for OWNER_USERNAME.
ADMIN_USERNAME=admin

# Frontend origins allowed to call this API (comma separated, no trailing slash).
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://YOURNAME.github.io

# SMTP for verification codes. If SMTP_HOST is empty, codes are printed to the console (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Chatisfying <no-reply@example.com>

# Object storage for uploads (S3 compatible). Leave empty to switch uploads off.
# Backblaze B2 example endpoint: https://s3.eu-central-003.backblazeb2.com  (region: eu-central-003)
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- Version 3
# Email via the Brevo web API (works on Render's free plan). Used before SMTP if both are set.
BREVO_API_KEY=
BREVO_SENDER=

# Testing aid ONLY: print verification codes into the server log. Leave OFF for real use
# (set to 1 for a moment if the email does not arrive and you need to look into the log).
DEBUG_LOG_CODES=

# Push notifications (VAPID keys). Create them ONCE with:  python gen_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# AI tab (Google Gemini). Get a key in Google AI Studio. The key stays on the server and is never sent to the browser.
# Read the notes about the free tier in the README first (data may be used by Google, 18+, not for private data).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
